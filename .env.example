# Run python scripts/configure.py to generate .env. Never commit it.
MOSAIC_MASTER_KEY=
MOSAIC_GRAPH_PASSWORD=
MOSAIC_SECURE_COOKIE=false
MOSAIC_HOSTS=localhost,127.0.0.1,testserver
# Recommended for fresh internet deployments so another visitor cannot claim owner setup.
MOSAIC_SETUP_TOKEN=
# Trust only the platform proxy range. Railway currently requires * for its dynamic private ingress.
FORWARDED_ALLOW_IPS=127.0.0.1
# Optional; server only. Disabled in every workspace until explicit payload consent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
